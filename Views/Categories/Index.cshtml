@model List<DishCategory_BIT240118>
@{
    ViewData["Title"] = L.T("title.categoryList");
    var confirmMsg = L.T("confirm.delete");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@L.T("title.categoryList")</h2>
    <a class="btn btn-success" asp-action="Create">+ @L.T("btn.create")</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">@L.T("empty.categories")</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>@L.T("field.categoryName")</th>
                    <th>@L.T("field.description")</th>
                    <th>@L.T("field.dishCount")</th>
                    <th>@L.T("field.actions")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.Name</td>
                        <td>@c.Description</td>
                        <td>
                            <a asp-controller="Dishes" asp-action="Index" asp-route-CategoryId="@c.Id">@c.Dishes.Count</a>
                        </td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">@L.T("btn.edit")</a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('@confirmMsg');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">@L.T("btn.delete")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
