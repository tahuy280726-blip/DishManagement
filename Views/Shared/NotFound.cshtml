@model string
@{
    ViewData["Title"] = L.T("title.notFound");
}
<div class="text-center py-5">
    <h1 class="display-4">404</h1>
    <h3>@L.T("title.notFound")</h3>
    <p class="lead text-danger">@L.T(Model ?? "err.pageNotFound")</p>
    <a class="btn btn-primary" asp-controller="Dishes" asp-action="Index">@L.T("btn.back")</a>
</div>
