@{
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var controller = Context.Request.RouteValues["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="@L.Lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @L.T("app.title")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Dishes" asp-action="Index">🍜 @L.T("app.title")</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Dishes" ? "active" : "")" asp-controller="Dishes" asp-action="Index">@L.T("nav.dishes")</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Categories" ? "active" : "")" asp-controller="Categories" asp-action="Index">@L.T("nav.categories")</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-light small">@L.T("nav.language"):</span>
                    <div class="btn-group btn-group-sm" role="group">
                        <a class="btn @(L.Lang == "en" ? "btn-light" : "btn-outline-light")"
                           href="@Url.Action("Set", "Language", new { lang = "en", returnUrl })">English</a>
                        <a class="btn @(L.Lang == "vi" ? "btn-light" : "btn-outline-light")"
                           href="@Url.Action("Set", "Language", new { lang = "vi", returnUrl })">Tiếng Việt</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @if (TempData["Success"] is string okKey)
        {
            <div class="alert alert-success">@L.T(okKey)</div>
        }
        @if (TempData["Error"] is string errKey)
        {
            <div class="alert alert-danger">@L.T(errKey)</div>
        }
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
